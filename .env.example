# Copie para .env e troque os valores. O .env nunca vai para o Git.

# Banco (usado pelo docker compose para criar o usuário do Mongo)
MONGO_ROOT_USER=corewallet
# Só letras e números: ela entra na DATABASE_URI sem codificação. Gere com: openssl rand -hex 16
MONGO_ROOT_PASSWORD=troque-esta-senha

# API
# 5000 não: no macOS ela é do AirPlay
PORT=4000
# Rodando a API no Mac com o Mongo do compose:
DATABASE_URI=mongodb://corewallet:troque-esta-senha@127.0.0.1:27017/corewallet?authSource=admin
# Mínimo de 32 caracteres. Gere com: openssl rand -hex 48
JWT_SECRET=troque-este-segredo
# Endereço do front, usado no CORS
WEB_ORIGIN=http://localhost:5173
# true quando servir por HTTPS (produção). Em http://localhost deixe false.
COOKIE_SECURE=false

# Login com o Google. Só o ID do cliente é necessário (não é segredo).
# Como criar: docs/CONFIGURACAO.md, seção "Login com Google". Vazio = botão desligado.
GOOGLE_CLIENT_ID=

# Envio de email para confirmar o cadastro. Vazio = não envia e não exige a confirmação.
# SMTP_URL: o endereço SMTP do seu provedor (Brevo, Resend, Gmail com senha de app...), por exemplo
#   smtps://usuario:senha@smtp.exemplo.com:465   (caracteres especiais na senha precisam de %XX)
# MAIL_FROM: o remetente, no formato  CoreWallet <nao-responda@seudominio.com>
# EMAIL_VERIFICATION=off envia os emails mas não exige a confirmação para entrar.
SMTP_URL=
MAIL_FROM=
EMAIL_VERIFICATION=

# Chave que cifra os segredos da verificação em duas etapas (32+ caracteres; gere com
# openssl rand -hex 32). Opcional: sem ela usa uma chave derivada do JWT_SECRET, e trocar o
# JWT_SECRET depois invalidaria os 2FA já ativados. Defina ANTES de alguém ativar o 2FA.
TOTP_ENCRYPTION_KEY=

# Captcha da Cloudflare (Turnstile). Vazio nas duas = captcha desligado.
# Como criar: docs/CONFIGURACAO.md, seção "Verificação anti-robô".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Para testar no seu computador sem criar nada, use as chaves públicas de teste da
# Cloudflare (o captcha sempre passa) e NODE_ENV_API=development. Nunca em produção:
# a API recusa essas chaves quando roda em produção.
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   NODE_ENV_API=development

# Só para os testes da API (use um banco separado, eles apagam os dados):
# TEST_DATABASE_URI=mongodb://corewallet:troque-esta-senha@127.0.0.1:27017/corewallet_test?authSource=admin

# Portas no computador (só 127.0.0.1). Mude se outro projeto já usa 8080 ou 27017,
# como num servidor compartilhado.
# WEB_PORT=8080
# MONGO_PORT=27017

# Proxies entre o navegador e a API. 1 = só o nginx do web (padrão); 2 = atrás de túnel
# (cloudflared/Cloudflare). Valor menor que o real faz todos dividirem o mesmo IP nos limites.
# TRUST_PROXY=1
